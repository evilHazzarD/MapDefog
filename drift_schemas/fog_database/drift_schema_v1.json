        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"walks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"start\" INTEGER NOT NULL, \"end\" INTEGER NOT NULL, \"meters\" REAL NOT NULL DEFAULT 0.0, \"cells\" INTEGER NOT NULL DEFAULT 0, \"caches\" INTEGER NOT NULL DEFAULT 0, \"lat\" REAL NOT NULL DEFAULT 0.0, \"lon\" REAL NOT NULL DEFAULT 0.0);"
        }
      ]
    },
    {
      "name": "waypoints",

    {
      "name": "days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"days\" (\"day\" INTEGER NOT NULL, \"cells\" INTEGER NOT NULL DEFAULT 0, \"meters\" REAL NOT NULL DEFAULT 0.0, \"caches\" INTEGER NOT NULL DEFAULT 0, \"rare\" INTEGER NOT NULL DEFAULT 0, \"beacon\" INTEGER NOT NULL DEFAULT 0 CHECK (\"beacon\" IN (0, 1)), \"night\" INTEGER NOT NULL DEFAULT 0, \"dawn\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "walks",

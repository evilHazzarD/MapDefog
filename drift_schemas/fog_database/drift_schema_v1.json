          "sql": "CREATE TABLE IF NOT EXISTS \"waypoints\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"walk\" INTEGER NOT NULL, \"at\" INTEGER NOT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL);"
        }
      ]
    },
    {
      "name": "finds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"finds\" (\"key\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"rarity\" INTEGER NOT NULL, \"relic\" TEXT NOT NULL DEFAULT '', \"duplicate\" INTEGER NOT NULL DEFAULT 0 CHECK (\"duplicate\" IN (0, 1)), \"coins\" INTEGER NOT NULL, \"xp\" INTEGER NOT NULL, \"lat\" REAL NOT NULL, \"lon\" REAL NOT NULL, \"seen\" INTEGER NOT NULL DEFAULT 0 CHECK (\"seen\" IN (0, 1)), PRIMARY KEY (\"key\"));"
